            </div>
            <div id="adventureFeedList">${renderAdventureListHtml()}</div>
          `;
        }
      } else if (appState.tab === 'stays') {
        body.innerHTML =
          toastHtml +
          appState.properties
            .map(
              (p) => `
          <div class="m-card">
            <div class="m-kicker">${escapeHtml(p.city)} · ★ ${p.rating} · ${p.availableRooms} left</div>
            <h3>${escapeHtml(p.name)}</h3>
            <div class="m-row-between">
              <span class="m-price">${escapeHtml(p.currency)} ${p.pricePerNight.toLocaleString()} / night</span>
              <button class="m-btn" ${p.availableRooms < 1 ? 'disabled' : ''} onclick="bookStay(${p.id})">${p.availableRooms < 1 ? 'Sold Out' : 'Book'}</button>
            </div>
          </div>
        `
            )
            .join('');
      } else if (appState.tab === 'rides') {
        body.innerHTML =
          toastHtml +
          `
          <div class="m-card">
            <h3>Request Ride</h3>
            <input class="m-input" id="mPickup" placeholder="Pickup (e.g. Entebbe Arrivals)">
            <input class="m-input" id="mDropoff" placeholder="Dropoff (e.g. Kololo)">
            <button class="m-btn" style="width:100%;" onclick="requestRide()">Request</button>
          </div>
          ${appState.rides
            .map(
              (r) => `
            <div class="m-card">
              <div class="m-kicker">${escapeHtml(r.ref)} · ${escapeHtml(r.status.toUpperCase())}</div>
              <h3>${escapeHtml(r.pickup)} → ${escapeHtml(r.dropoff)}</h3>
              <span class="m-price">${escapeHtml(r.currency)} ${r.estimatedFare.toLocaleString()}</span>
            </div>
          `
            )
            .join('')}
          ${appState.routes
            .map(
              (r) => `
            <div class="m-card">
              <div class="m-kicker">${escapeHtml(r.city)} · ${escapeHtml(r.nextDeparture)}</div>
              <h3>${escapeHtml(r.origin)} → ${escapeHtml(r.destination)}</h3>
              <span class="m-price">${escapeHtml(r.currency)} ${r.baseFare.toLocaleString()} · ${r.estimatedMinutes} min</span>
            </div>
          `
            )
            .join('')}
        `;
      } else if (appState.tab === 'wallet') {
        const w = appState.wallet;
        body.innerHTML =
          toastHtml +
          `
          <div class="m-hero">
            <div style="font-size:0.75rem; opacity:0.85;">${w ? escapeHtml(w.accountName) : 'Pamoja Wallet'}</div>
            <h2 style="font-size:1.65rem; color:var(--accent);">${w ? escapeHtml(w.currency) + ' ' + w.balance.toLocaleString() : '—'}</h2>
          </div>
          <div class="m-card">
            <h3>Top Up</h3>
            <input class="m-input" id="mTopUp" type="number" value="50000">
            <button class="m-btn" style="width:100%;" onclick="depositWallet()">Add Funds</button>
          </div>
          ${appState.transactions
            .map(
              (tx) => `
            <div class="m-card">
              <div class="m-row-between">
                <div>
                  <div style="font-weight:700; font-size:0.88rem;">${escapeHtml(tx.sourceOrRecipient)}</div>
                  <div class="m-kicker">${escapeHtml(tx.reference)}</div>
                </div>
                <span class="m-price" style="color:${tx.amount >= 0 ? 'var(--success)' : 'var(--danger)'}">${tx.amount >= 0 ? '+' : ''}${escapeHtml(tx.currency)} ${tx.amount.toLocaleString()}</span>
              </div>
            </div>
          `
            )
            .join('')}
        `;
      } else if (appState.tab === 'account') {
        const u = appState.user;
        body.innerHTML =
          toastHtml +
          `
          <div class="m-card">
            <h3>${u ? escapeHtml(u.fullName) : 'Guest'}</h3>
            <div class="m-kicker">${u ? escapeHtml(u.email) + ' · ' + escapeHtml(u.country) : 'Sign in to sync'}</div>
          </div>
          <div class="m-card">
            <h3>Sign In</h3>
            <input class="m-input" id="mEmail" value="amina@pamoja.space">
            <input class="m-input" id="mPass" type="password" value="Pamoja2027!">
            <button class="m-btn" style="width:100%;" onclick="mobileLogin()">Sign In</button>
          </div>
        `;
      } else if (appState.tab === 'about') {
        body.innerHTML =
          toastHtml +
          `
          <div class="m-hero">
            <div style="font-size:0.72rem; color:var(--accent); font-weight:700;">ARCHITECTURE</div>
            <h2>Pamoja Mobile Stack</h2>
            <p>Expo SDK 52 · React Navigation · Flask Bearer API</p>
          </div>
          <div class="m-card">
            <div class="m-row-between">
              <div>
                <h3 style="margin-bottom:2px;">User App Preview</h3>
                <div class="m-kicker" style="margin:0;">Switch device shell</div>
              </div>
              <div class="segmented" role="group" aria-label="Target OS shell">
                <button type="button" class="seg-btn ${appState.os === 'ios' ? 'active' : ''}" onclick="setOs('ios')">iOS</button>
                <button type="button" class="seg-btn ${appState.os === 'android' ? 'active' : ''}" onclick="setOs('android')">Android</button>
              </div>
            </div>
          </div>
          <div class="m-card">
            <h3>Get Mobile App (iOS &amp; Android)</h3>
            <div class="m-kicker">Download React Native source (.zip / .tar.gz), Expo Go setup &amp; EAS binaries.</div>
            <a href="/get-app" class="m-btn" style="width:100%; margin-top:10px;">
              <i class="fa-solid fa-mobile-screen-button"></i> Get Mobile App
            </a>
          </div>
          <div class="m-card">
            <h3>Expo &amp; SecureStore</h3>
            <div class="m-kicker">Keychain/Keystore JWT persistence &amp; EAS iOS/Android builds.</div>
          </div>
          <div class="m-card">
            <h3>React Navigation</h3>
            <div class="m-kicker">7 top-level tabs + nested Events Native Stack.</div>
          </div>
          <div class="m-card">
            <h3>Backend Health</h3>
            <div class="m-kicker">${escapeHtml(appState.healthStatus)}</div>
            <button class="m-btn m-btn-outline" style="width:100%; margin-top:8px;" onclick="pingBackendHealth()">Ping /api/health/ping</button>
          </div>
        `;
      }
    }

    window.switchTab = function(tab) {
      appState.tab = tab;
      if (tab !== 'events') {
        appState.selectedEvent = null;
        appState.selectedRegistration = null;
      }
      renderAll();
    };

    window.openEventDetail = function(slug) {
      appState.selectedRegistration = null;
      appState.selectedEvent = appState.events.find((e) => e.slug === slug) || null;
      renderAll();
    };

    window.registerEvent = async function(slug, ticketTypeId) {
      const res = await api(`/api/events/${encodeURIComponent(slug)}/register`, {
        method: 'POST',
        body: JSON.stringify({ ticketTypeId, quantity: 1 }),
      });
      if (res.registration) {
        await loadData();
        appState.selectedEvent = null;
        appState.selectedRegistration = res.registration;
        setToast(`Ticket confirmed (${res.registration.ref})`);
      }
    };

    window.bookStay = async function(propertyId) {
      const res = await api('/api/accommodation/book', {
        method: 'POST',
        body: JSON.stringify({ propertyId, nights: 2, guests: 1 }),
      });
      if (res.booking) {
        await loadData();
        setToast(`Stay booked (${res.booking.ref})`);
      }
    };

    window.requestRide = async function() {
      const pickup = document.getElementById('mPickup').value.trim();
      const dropoff = document.getElementById('mDropoff').value.trim();
      if (!pickup || !dropoff) return;
      const res = await api('/api/transport/ride-request', {
        method: 'POST',
        body: JSON.stringify({ pickup, dropoff, serviceType: 'standard' }),
      });
      if (res.ride) {
        await loadData();
        setToast(`Ride dispatched (${res.ride.ref})`);
      }
    };

    window.depositWallet = async function() {
      const amount = Number(document.getElementById('mTopUp').value);
      if (!amount || amount <= 0) return;
      const res = await api('/api/wallet/deposit', {
        method: 'POST',
        body: JSON.stringify({ amount, source: 'mobile_money' }),
      });
      if (res.transaction) {
        await loadData();
        setToast(`Added ${res.account.currency} ${amount.toLocaleString()}`);
      }
    };

    function renderAdventureListHtml() {
      const q = appState.adventureQuery.trim().toLowerCase();
      const filteredTours = q
        ? appState.tourism.filter((t) => {
            const hay = `${t.title} ${t.region} ${t.country} ${t.category} ${t.operatorName || ''} ${t.meetingPoint || ''} ${t.summary}`.toLowerCase();
            return hay.includes(q);
          })
        : appState.tourism;

      const joinedHtml = appState.tourBookings.length
        ? `
          <div class="m-card" style="background:var(--surface-alt);">
            <div class="m-kicker">MY JOINED TOURS (${appState.tourBookings.length})</div>
            ${appState.tourBookings
              .map(
                (b) => `
              <div style="padding:8px 0; border-bottom:1px solid var(--border);">
                <div style="font-weight:700; font-size:0.88rem;">${escapeHtml(b.tourTitle)}</div>
                <div class="m-kicker" style="margin:2px 0 0;">${escapeHtml(b.ref)} · ${escapeHtml(b.operatorName)} · Meet: ${escapeHtml(b.meetingPoint)} (${escapeHtml(b.departureDate)})</div>
              </div>
            `
              )
              .join('')}
          </div>
        `
        : '';

      const toursHtml = filteredTours.length
        ? filteredTours
            .map(
              (t) => `
            <div class="m-card">
              <div class="m-kicker">${escapeHtml(t.category)} · ${escapeHtml(t.region)}, ${escapeHtml(t.country)} · ${escapeHtml(t.departureDate || t.duration)}</div>
              <h3>${escapeHtml(t.title)}</h3>
              <p>${escapeHtml(t.summary)}</p>
              <div class="m-kicker" style="margin-bottom:10px;">Operator: ${escapeHtml(t.operatorName || 'Verified Pamoja Operator')} · Meet: ${escapeHtml(t.meetingPoint || t.region)} · ${t.spotsLeft ?? 0} spots left</div>
              <div class="m-row-between">
                <span class="m-price">${escapeHtml(t.currency)} ${Number(t.price).toLocaleString()}</span>
                <button type="button" class="m-btn" ${(t.spotsLeft ?? 1) < 1 ? 'disabled' : ''} onclick="joinTour(${t.id})">${(t.spotsLeft ?? 1) < 1 ? 'Full' : 'Join Tour'}</button>
              </div>
            </div>
          `
            )
            .join('')
        : `<div class="m-card"><div class="m-kicker" style="margin:0;">No tours match "${escapeHtml(appState.adventureQuery)}". Switch to Organise Tour to post one.</div></div>`;

      return joinedHtml + toursHtml;
    }

    window.setAdventureMode = function(mode) {
      appState.adventureMode = mode === 'organise' ? 'organise' : 'join';
      renderPhone();
    };

    window.updateAdventureQuery = function(val) {
      appState.adventureQuery = val;
      const listEl = document.getElementById('adventureFeedList');
      if (listEl) listEl.innerHTML = renderAdventureListHtml();
    };

    window.joinTour = async function(tourId) {
      const res = await api('/api/tourism/join', {
        method: 'POST',
        body: JSON.stringify({ tourId, guests: 1 }),
      });
      if (res.booking) {
        await loadData();
        setToast(`Joined tour (${res.booking.ref})`);
      } else {
        setToast(res.error || 'Unable to join tour');
      }
    };

    window.organiseTour = async function() {
      const title = document.getElementById('advTitle').value.trim();
      const region = document.getElementById('advRegion').value.trim();
      const country = document.getElementById('advCountry').value.trim() || 'Uganda';
      const category = document.getElementById('advCategory').value.trim() || 'Guided Expedition';
      const operatorName = document.getElementById('advOperator').value.trim() || 'Verified Pamoja Operator';
      const meetingPoint = document.getElementById('advMeetingPoint').value.trim();
      const departureDate = document.getElementById('advDeparture').value.trim() || '2027-07-24 · 07:30';
      const duration = document.getElementById('advDuration').value.trim() || 'Half Day (5 hrs)';
      const price = Number(document.getElementById('advPrice').value) || 150000;
      const spotsTotal = Number(document.getElementById('advSpots').value) || 12;
      const summary = document.getElementById('advSummary').value.trim();

      if (!title || !region || !meetingPoint) {
        setToast('Enter tour title, region & meeting point');
        return;
      }

      const res = await api('/api/tourism/tours', {
        method: 'POST',
        body: JSON.stringify({
          title,
          region,
          country,
          category,
          operatorName,
          meetingPoint,
          departureDate,
          duration,
          price,
          spotsTotal,
          summary,
        }),
      });

      if (res.listing) {
        appState.adventureMode = 'join';
        await loadData();
        setToast(`Tour published: ${res.listing.title}`);
      } else {
        setToast(res.error || 'Unable to publish tour');
      }
    };

    window.mobileLogin = async function() {
      const email = document.getElementById('mEmail').value.trim();
      const password = document.getElementById('mPass').value;
      const res = await api('/api/auth/mobile/login', {
        method: 'POST',
        body: JSON.stringify({ email, password }),
      });
      if (res.access_token) {
        appState.token = res.access_token;
        appState.user = res.user;
        await loadData();
        setToast(`Signed in as ${res.user.fullName}`);
      } else {
        setToast(res.error || 'Sign in failed');
      }
    };

    window.toggleBreadcrumbMenu = function(evt) {
      if (evt) evt.stopPropagation();
      const menu = document.getElementById('breadcrumbMenuDropdown');
      const btn = document.getElementById('breadcrumbMenuBtn');
      if (!menu) return;
      const isOpen = menu.classList.toggle('open');
      if (btn) btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    };

    window.closeBreadcrumbMenu = function() {
      const menu = document.getElementById('breadcrumbMenuDropdown');
      const btn = document.getElementById('breadcrumbMenuBtn');
      if (menu) menu.classList.remove('open');
      if (btn) btn.setAttribute('aria-expanded', 'false');
    };

    window.selectBreadcrumbTab = function(tab) {
      closeBreadcrumbMenu();
      switchTab(tab);
    };

    document.addEventListener('click', (e) => {
      const menu = document.getElementById('breadcrumbMenuDropdown');
      const btn = document.getElementById('breadcrumbMenuBtn');
      if (!menu || !menu.classList.contains('open')) return;
      if (!menu.contains(e.target) && (!btn || !btn.contains(e.target))) {
        closeBreadcrumbMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeBreadcrumbMenu();
    });

    document.querySelectorAll('.tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => switchTab(btn.dataset.tab));
    });

    loadData();
  </script>
</body>
</html>
