<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pamoja — User App</title>
  <meta name="description" content="Pamoja customer mobile app for East Africa events, verified stays, airport rides, tourism discovery, and mobile wallet.">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/static/css/mobile-studio.css">
</head>
<body>
  <header class="topbar">
    <nav class="breadcrumb" id="appBreadcrumb" aria-label="Breadcrumb">
      <a href="/" class="brand-wordmark" onclick="event.preventDefault(); switchTab('home');">Pamoja</a>
      <span class="crumb-sep" aria-hidden="true">/</span>
      <button type="button" class="crumb-menu-trigger" onclick="toggleBreadcrumbMenu(event)">
        <span>Home</span>
        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
      </button>
    </nav>
    <button
      type="button"
      class="menu-toggle-btn"
      id="breadcrumbMenuBtn"
      aria-expanded="false"
      aria-controls="breadcrumbMenuDropdown"
      onclick="toggleBreadcrumbMenu(event)"
    >
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
      <span>Menu</span>
    </button>
  </header>

  <div class="crumb-dropdown" id="breadcrumbMenuDropdown" role="menu" aria-label="App navigation menu">
    <button type="button" class="crumb-dropdown-item active" data-crumb-tab="home" onclick="selectBreadcrumbTab('home')"><i class="fa-solid fa-house"></i><span>Home</span></button>
    <button type="button" class="crumb-dropdown-item" data-crumb-tab="events" onclick="selectBreadcrumbTab('events')"><i class="fa-solid fa-ticket"></i><span>Events &amp; Tickets</span></button>
    <button type="button" class="crumb-dropdown-item" data-crumb-tab="adventure" onclick="selectBreadcrumbTab('adventure')"><i class="fa-solid fa-compass"></i><span>Adventure</span></button>
    <button type="button" class="crumb-dropdown-item" data-crumb-tab="stays" onclick="selectBreadcrumbTab('stays')"><i class="fa-solid fa-bed"></i><span>Stays</span></button>
    <button type="button" class="crumb-dropdown-item" data-crumb-tab="rides" onclick="selectBreadcrumbTab('rides')"><i class="fa-solid fa-car"></i><span>Rides</span></button>
    <button type="button" class="crumb-dropdown-item" data-crumb-tab="wallet" onclick="selectBreadcrumbTab('wallet')"><i class="fa-solid fa-wallet"></i><span>Wallet</span></button>
    <button type="button" class="crumb-dropdown-item" data-crumb-tab="account" onclick="selectBreadcrumbTab('account')"><i class="fa-solid fa-user"></i><span>Account</span></button>
    <button type="button" class="crumb-dropdown-item" data-crumb-tab="about" onclick="selectBreadcrumbTab('about')"><i class="fa-solid fa-circle-info"></i><span>About</span></button>
    <div class="crumb-dropdown-divider" role="separator"></div>
    <a href="/get-app" class="crumb-dropdown-item"><i class="fa-solid fa-mobile-screen-button"></i><span>Get Mobile App</span></a>
  </div>

  <main class="workspace">
    <section class="device-column" aria-label="Pamoja App">
      <div class="phone-shell" id="phoneShell">
        <div class="phone-header">
          <span class="phone-header-title" id="phoneHeaderTitle">Pamoja</span>
          <span class="phone-header-meta" id="phoneHeaderMeta">East Africa</span>
        </div>

        <div class="phone-body" id="phoneBody"></div>

        <nav class="phone-tabbar" aria-label="Mobile tabs">
          <button type="button" class="tab-btn active" data-tab="home"><i class="fa-solid fa-house"></i><span>Home</span></button>
          <button type="button" class="tab-btn" data-tab="events"><i class="fa-solid fa-ticket"></i><span>Events</span></button>
          <button type="button" class="tab-btn" data-tab="stays"><i class="fa-solid fa-bed"></i><span>Stays</span></button>
          <button type="button" class="tab-btn" data-tab="rides"><i class="fa-solid fa-car"></i><span>Rides</span></button>
          <button type="button" class="tab-btn" data-tab="wallet"><i class="fa-solid fa-wallet"></i><span>Wallet</span></button>
          <button type="button" class="tab-btn" data-tab="account"><i class="fa-solid fa-user"></i><span>Account</span></button>
          <button type="button" class="tab-btn" data-tab="about"><i class="fa-solid fa-circle-info"></i><span>About</span></button>
        </nav>
      </div>
    </section>

    <section class="desktop-companion-col" aria-label="Pamoja Home">
      <div class="pj-hero-stage desktop">
        <div class="pj-hero-card desktop">
          <div class="pj-hero-copy">
            <div>
              <div class="pj-hero-eyebrow">East Africa Companion</div>
              <h1 class="pj-hero-title">Your world,<br><em>together.</em></h1>
            </div>
            <p class="pj-hero-sub">Events, stays, rides &amp; passes in one calm place.</p>
          </div>
          <div class="pj-hero-art" aria-hidden="true">
            <svg viewBox="0 0 260 185" width="256" height="182" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <radialGradient id="deskSunHalo" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(96 34) rotate(90) scale(48)">
                  <stop stop-color="#FCEEE2" stop-opacity="0.95"/>
                  <stop offset="0.55" stop-color="#F5B700" stop-opacity="0.28"/>
                  <stop offset="1" stop-color="#F5B700" stop-opacity="0"/>
                </radialGradient>
                <linearGradient id="deskHillBack" x1="20" y1="90" x2="250" y2="150" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#9FC8AC"/>
                  <stop offset="1" stop-color="#6FA784"/>
                </linearGradient>
                <linearGradient id="deskHillFront" x1="12" y1="120" x2="255" y2="180" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#3F7E59"/>
                  <stop offset="1" stop-color="#1E5B39"/>
                </linearGradient>
              </defs>
              <circle cx="96" cy="34" r="46" fill="url(#deskSunHalo)"/>
              <circle cx="96" cy="34" r="9.5" fill="#EA8426"/>
              <path d="M18 142C52 110 88 98 124 102C162 106 196 86 254 114V152H18V142Z" fill="url(#deskHillBack)" opacity="0.55"/>
              <rect x="114" y="48" width="14" height="68" rx="2.5" fill="#79AE8C"/>
              <rect x="118" y="56" width="3" height="8" rx="1" fill="#E3F0E7" opacity="0.7"/>
              <rect x="132" y="30" width="18" height="86" rx="2.5" fill="#5D9A74"/>
              <rect x="137" y="40" width="3.5" height="10" rx="1" fill="#E3F0E7" opacity="0.7"/>
              <rect x="143" y="40" width="3.5" height="10" rx="1" fill="#E3F0E7" opacity="0.7"/>
              <rect x="154" y="54" width="13" height="62" rx="2.5" fill="#8CC09E"/>
              <rect x="171" y="38" width="20" height="78" rx="2.5" fill="#498762"/>
              <rect x="177" y="48" width="4" height="11" rx="1" fill="#FCEEE2" opacity="0.7"/>
              <rect x="195" y="58" width="14" height="58" rx="2.5" fill="#75AC89"/>
              <rect x="213" y="70" width="13" height="46" rx="2.5" fill="#9BC9AB"/>
              <path d="M40 128V96M20 96C20 86 32 79 44 79C56 79 67 86 67 96H20Z" stroke="#427A58" stroke-width="4" stroke-linecap="round"/>
              <path d="M20 96C20 86 32 79 44 79C56 79 67 86 67 96H20Z" fill="#57946E"/>
              <path d="M12 162C46 122 92 114 138 122C184 130 218 108 256 132V185H12V162Z" fill="url(#deskHillFront)"/>
              <circle cx="106" cy="108" r="19" fill="#231915"/>
              <circle cx="107" cy="110" r="12.5" fill="#7B492D"/>
              <path d="M84 185L90 138C92 127 102 122 112 123C122 124 129 131 131 142L136 185H84Z" fill="#DC721E"/>
              <path d="M103 123L109 139L116 123" fill="#A94E0F"/>
              <circle cx="164" cy="95" r="13.5" fill="#6F4026"/>
              <path d="M150 92C151 82 159 77 167 78C174 79 179 85 178 93C173 88 164 87 150 92Z" fill="#1F1917"/>
              <path d="M137 185L142 132C144 119 155 111 169 111C183 111 195 119 198 134L204 185H137Z" fill="#135231"/>
              <path d="M157 113H179L173 185H161L157 113Z" fill="#F6F4EE"/>
            </svg>
          </div>
          <div class="pj-hero-backdrop-hills" aria-hidden="true"></div>

          <div class="pj-hero-search-layer desktop">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input
              type="search"
              id="desktopSearchInput"
              placeholder="Search transport, stays, events, adventure..."
              oninput="updateSearchQuery(this.value)"
              onkeydown="if(event.key==='Enter'){event.preventDefault();commitSearch();}"
            >
            <button type="button" class="pj-search-clear" id="desktopSearchClear" style="display:none;" aria-label="Clear search" onclick="updateSearchQuery('')">
              <i class="fa-solid fa-circle-xmark"></i>
            </button>
            <button type="button" class="pj-hero-search-pill-btn" onclick="commitSearch()">Search</button>
          </div>
        </div>

        <div class="pj-floating-results desktop" id="desktopSearchResults" style="display:none;"></div>
      </div>

      <h2 class="pj-section-title" style="font-size:1.34rem; margin-bottom:14px;">Make yourself <em>feel at home</em></h2>

      <div class="pj-grid-2x2 desktop">
        <button type="button" class="pj-service-card" onclick="switchTab('rides')">
          <div class="pj-service-top">
            <span class="pj-service-icon mint"><i class="fa-solid fa-bus"></i></span>
            <span class="pj-service-arrow" aria-hidden="true">&#8599;</span>
          </div>
          <div>
            <div class="pj-service-name">Transport</div>
            <div class="pj-service-desc">Find your ride</div>
          </div>
        </button>

        <button type="button" class="pj-service-card" onclick="switchTab('stays')">
          <div class="pj-service-top">
            <span class="pj-service-icon peach"><i class="fa-solid fa-bed"></i></span>
            <span class="pj-service-arrow" aria-hidden="true">&#8599;</span>
          </div>
          <div>
            <div class="pj-service-name">Stays</div>
            <div class="pj-service-desc">Find a place to stay</div>
          </div>
        </button>

        <button type="button" class="pj-service-card" onclick="switchTab('events')">
          <div class="pj-service-top">
            <span class="pj-service-icon peach"><i class="fa-regular fa-calendar"></i></span>
            <span class="pj-service-arrow" aria-hidden="true">&#8599;</span>
          </div>
          <div>
            <div class="pj-service-name">Events &amp; Tickets</div>
            <div class="pj-service-desc">Events &amp; QR passes</div>
          </div>
        </button>

        <button type="button" class="pj-service-card" onclick="switchTab('adventure')">
          <div class="pj-service-top">
            <span class="pj-service-icon mint"><i class="fa-solid fa-compass"></i></span>
            <span class="pj-service-arrow" aria-hidden="true">&#8599;</span>
          </div>
          <div>
            <div class="pj-service-name">Adventure</div>
            <div class="pj-service-desc">Organise &amp; join tours</div>
          </div>
        </button>
      </div>

      <button type="button" class="pj-wallet-banner" onclick="switchTab('wallet')">
        <div class="pj-wallet-left">
          <span class="pj-wallet-icon-box"><i class="fa-solid fa-wallet"></i></span>
          <div>
            <div class="pj-wallet-title">Your Pamoja wallet</div>
            <div class="pj-wallet-sub">Payments, all in one place</div>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
      </button>

      <button type="button" class="pj-bookings-card" onclick="switchTab('stays')">
        <div class="pj-bookings-left">
          <span class="pj-service-icon mint"><i class="fa-regular fa-calendar-check"></i></span>
          <div>
            <div class="pj-service-name">My bookings</div>
            <div class="pj-service-desc">Manage your stays and rides</div>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right" style="color:var(--muted);" aria-hidden="true"></i>
      </button>

      <div class="m-card" id="myEventsPanel" style="margin-top:16px;">
        <div class="home-section-head">
          <h2>My Passes</h2>
          <button type="button" class="m-btn m-btn-outline" style="min-height:36px; padding:0 12px;" onclick="switchTab('events')">All Events</button>
        </div>
        <div id="desktopMyEvents">Loading passes...</div>
      </div>
    </section>
  </main>

  <script>
    const IMAGES = {
      hero: '/src/assets/images/hero_east_africa_1794835519725.jpg',
      event: '/src/assets/images/event_stadium_pass_1794835521456.jpg',
      stay: '/src/assets/images/stay_kampala_villa_1794835521524.jpg',
      transport: '/src/assets/images/ride_airport_suv_1794835520377.jpg',
      tourism: '/src/assets/images/hero_east_africa_1794835519725.jpg',
    };

    const appState = {
      os: 'ios',
      tab: 'home',
      token: null,
      user: null,
      toast: '',
      query: '',
      searchScope: 'all',
      recentSearches: ['Kampala', 'Entebbe', 'VIP Pass'],
      feed: [],
      events: [],
      selectedEvent: null,
      selectedRegistration: null,
      registrations: [],
      properties: [],
      routes: [],
      rides: [],
      tourism: [],
      tourBookings: [],
      adventureMode: 'join',
      adventureQuery: '',
      wallet: null,
      transactions: [],
      healthStatus: 'Tap Ping to test /api/health/ping',
    };

    function escapeHtml(val) {
      return String(val ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function imageForType(type) {
      return IMAGES[type] || IMAGES.event;
    }

    function authHeaders() {
      const h = { 'Content-Type': 'application/json' };
      if (appState.token) h['Authorization'] = 'Bearer ' + appState.token;
      return h;
    }

    async function api(url, opts) {
      const r = await fetch(url, { ...(opts || {}), headers: { ...authHeaders(), ...(opts && opts.headers || {}) } });
      return r.json();
    }

    function setToast(msg) {
      appState.toast = msg;
      renderAll();
      setTimeout(() => {
        if (appState.toast === msg) {
          appState.toast = '';
          renderAll();
        }
      }, 3500);
    }

    function buildQrSvg(refCode) {
      const seed = Array.from(String(refCode || 'PAMOJA')).reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
      let rects = '';
      for (let row = 0; row < 7; row++) {
        for (let col = 0; col < 7; col++) {
          const corner = (row < 2 && col < 2) || (row < 2 && col > 4) || (row > 4 && col < 2);
          const bit = corner || ((seed + row * 11 + col * 7) % 3 === 0);
          if (bit) {
            rects += `<rect x="${col * 14 + 4}" y="${row * 14 + 4}" width="11" height="11" rx="2" fill="#163321" />`;
          }
        }
      }
      return `<svg class="qr-code-svg" viewBox="0 0 106 106" role="img" aria-label="Ticket QR code">${rects}</svg>`;
    }

    async function loadData() {
      const [feedRes, evtRes, propRes, trnRes, tourRes, wltRes, summaryRes] = await Promise.all([
        api('/api/home/feed?per_page=20'),
        api('/api/events'),
        api('/api/accommodation/properties'),
        api('/api/transport/routes'),
        api('/api/tourism').catch(() => ({ listings: [] })),
        api('/api/wallet'),
        api('/api/user/summary').catch(() => ({ user: null, registrations: [] })),
      ]);
      appState.feed = feedRes.items || [];
      appState.events = evtRes.events || [];
      appState.properties = propRes.properties || [];
      appState.routes = trnRes.routes || [];
      appState.rides = trnRes.activeRequests || [];
      appState.tourism = tourRes.listings || [];
      appState.tourBookings = tourRes.bookings || summaryRes.tours || [];
      appState.wallet = wltRes.account || null;
      appState.transactions = wltRes.transactions || [];
      appState.user = summaryRes.user || null;
      appState.registrations = summaryRes.registrations || [];
      renderAll();
    }

    function buildSearchCatalogue() {
      const catalogue = [];

      appState.routes.forEach((r) => {
        catalogue.push({
          scope: 'transport',
          categoryLabel: 'Transport',
          title: `${r.origin} -> ${r.destination}`,
          meta: `${r.city} · ${r.vehicleClass} · ${r.currency} ${Number(r.baseFare).toLocaleString()}`,
          keywords: `transport ride shuttle bus airport transfer ${r.code} ${r.city} ${r.origin} ${r.destination} ${r.vehicleClass}`,
          action: () => switchTab('rides'),
        });
      });

      appState.rides.forEach((ride) => {
        catalogue.push({
          scope: 'transport',
          categoryLabel: 'Active Ride',
          title: `${ride.pickup} -> ${ride.dropoff}`,
          meta: `${ride.ref} · ${ride.status} · ${ride.currency} ${Number(ride.estimatedFare).toLocaleString()}`,
          keywords: `transport ride cab car driver ${ride.ref} ${ride.pickup} ${ride.dropoff} ${ride.serviceType} ${ride.driverName}`,
          action: () => switchTab('rides'),
        });
      });

      appState.properties.forEach((p) => {
        catalogue.push({
          scope: 'stays',
          categoryLabel: 'Accommodation',
          title: p.name,
          meta: `${p.city}, ${p.country} · ${p.currency} ${Number(p.pricePerNight).toLocaleString()} / night`,
          keywords: `stays accommodation hotel apartment lodge riad room sleep ${p.city} ${p.country} ${p.propertyType} ${(p.amenities || []).join(' ')} ${p.description}`,
          action: () => switchTab('stays'),
        });
      });

      appState.events.forEach((ev) => {
        const tierNames = (ev.ticketTypes || []).map((t) => t.name).join(' ');
        const leadTier = ev.ticketTypes && ev.ticketTypes[0];
        const priceMeta = leadTier ? `From ${leadTier.currency} ${Number(leadTier.price).toLocaleString()}` : ev.category;
        catalogue.push({
          scope: 'events',
          categoryLabel: 'Event',
          title: ev.name,
          meta: `${ev.city} · ${ev.startDate} · ${priceMeta}`,
          keywords: `events festival marathon conference concert match ${ev.city} ${ev.country} ${ev.venue} ${ev.category} ${ev.organizer} ${tierNames} ${ev.description}`,
          action: () => openEventDetail(ev.slug),
        });
      });

      appState.registrations.forEach((reg) => {
        catalogue.push({
          scope: 'events',
          categoryLabel: 'My Ticket',
          title: `${reg.eventName} (${reg.ticketTypeName})`,
          meta: `Pass ${reg.ref} · QR Entry Ready`,
          keywords: `ticket tickets pass passes qr badge registration ${reg.ref} ${reg.eventName} ${reg.ticketTypeName} ${reg.attendeeName}`,
          action: () => openRegistrationTicket(reg.ref),
        });
      });

      appState.tourism.forEach((t) => {
        catalogue.push({
          scope: 'adventure',
          categoryLabel: 'Adventure Tour',
          title: t.title,
          meta: `${t.region}, ${t.country} · ${t.operatorName || 'Verified Operator'} · ${t.currency} ${Number(t.price).toLocaleString()}`,
          keywords: `tourism adventure safari tour operator join organise guide wildlife nature ${t.region} ${t.country} ${t.category} ${t.operatorName || ''} ${t.meetingPoint || ''} ${t.summary}`,
          action: () => switchTab('adventure'),
        });
      });

      if (appState.wallet) {
        catalogue.push({
          scope: 'wallet',
          categoryLabel: 'Wallet',
          title: 'Your Pamoja Wallet',
          meta: `${appState.wallet.currency} ${Number(appState.wallet.balance).toLocaleString()} · Mobile Money & Payments`,
          keywords: 'wallet balance pay payment deposit top up money transfer ugx kes tzs',
          action: () => switchTab('wallet'),
        });
      }

      return catalogue;
    }

    function getSearchMatches() {
      const q = appState.query.trim().toLowerCase();
      const catalogue = buildSearchCatalogue();
      if (!q && appState.searchScope === 'all') return [];
      const tokens = q ? q.split(/\s+/).filter(Boolean) : [];
      return catalogue.filter((item) => {
        if (appState.searchScope !== 'all' && item.scope !== appState.searchScope) return false;
        if (!tokens.length) return true;
        const haystack = `${item.title} ${item.meta} ${item.categoryLabel} ${item.keywords}`.toLowerCase();
        return tokens.every((tk) => haystack.includes(tk));
      });
    }

    let currentSearchMatches = [];

    window.setSearchScope = function(scope) {
      appState.searchScope = scope;
      updateSearchResultContainers();
    };

    window.selectSearchMatch = function(index) {
      const item = currentSearchMatches[index];
      if (item && typeof item.action === 'function') {
        item.action();
      }
    };

    function renderSearchResultsHtml(items) {
      const q = appState.query.trim();
      if (!q && appState.searchScope === 'all') return '';

      const scopes = [
        { id: 'all', label: 'All' },
        { id: 'transport', label: 'Transport' },
        { id: 'stays', label: 'Stays' },
        { id: 'events', label: 'Events' },
        { id: 'adventure', label: 'Adventure' },
      ];

      const tabsHtml = `
        <div class="pj-search-tabs" role="tablist" aria-label="Search categories">
          ${scopes
            .map(
              (s) =>
                `<button type="button" class="pj-search-tab ${appState.searchScope === s.id ? 'active' : ''}" onclick="setSearchScope('${s.id}')">${s.label}</button>`
            )
            .join('')}
        </div>
      `;

      if (!items.length) {
        return (
          tabsHtml +
          `<div style="padding:10px 6px; font-size:0.82rem; color:var(--muted);">No matches found${q ? ` for "${escapeHtml(appState.query)}"` : ''}.</div>`
        );
      }

      currentSearchMatches = items.slice(0, 8);
      return (
        tabsHtml +
        currentSearchMatches
          .map(
            (item, idx) => `
            <button type="button" class="pj-search-item" onclick="selectSearchMatch(${idx})">
              <div style="min-width:0;">
                <div style="font-weight:700; font-size:0.86rem; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${escapeHtml(item.title)}</div>
                <div style="font-size:0.74rem; color:var(--muted);">${escapeHtml(item.categoryLabel)} &middot; ${escapeHtml(item.meta)}</div>
              </div>
              <i class="fa-solid fa-chevron-right" style="color:var(--brand); font-size:0.78rem; flex-shrink:0;" aria-hidden="true"></i>
            </button>
          `
          )
          .join('')
      );
    }

    function updateSearchResultContainers() {
      const hasActiveSearch = appState.query.trim().length > 0 || appState.searchScope !== 'all';
      const matches = getSearchMatches();
      const resultsHtml = renderSearchResultsHtml(matches);

      const phoneResults = document.getElementById('phoneSearchResults');
      if (phoneResults) {
        phoneResults.innerHTML = resultsHtml;
        phoneResults.style.display = hasActiveSearch ? 'flex' : 'none';
      }
      const phoneClear = document.getElementById('phoneSearchClear');
      if (phoneClear) {
        phoneClear.style.display = hasActiveSearch ? 'inline-flex' : 'none';
      }

      const deskResults = document.getElementById('desktopSearchResults');
      if (deskResults) {
        deskResults.innerHTML = resultsHtml;
        deskResults.style.display = hasActiveSearch ? 'flex' : 'none';
      }
      const deskClear = document.getElementById('desktopSearchClear');
      if (deskClear) {
        deskClear.style.display = hasActiveSearch ? 'inline-flex' : 'none';
      }
    }

    window.updateSearchQuery = function(val) {
      appState.query = val;
      if (!val.trim() && appState.searchScope !== 'all') {
        appState.searchScope = 'all';
      }
      const phoneSearch = document.getElementById('phoneSearchInput');
      if (phoneSearch && phoneSearch.value !== val) phoneSearch.value = val;
      const deskSearch = document.getElementById('desktopSearchInput');
      if (deskSearch && deskSearch.value !== val) deskSearch.value = val;
      updateSearchResultContainers();
    };

    window.commitSearch = function(term) {
      const val = (typeof term === 'string' ? term : appState.query).trim();
      if (!val) {
        appState.searchScope = appState.searchScope === 'all' ? 'transport' : 'all';
        updateSearchResultContainers();
        return;
      }
      appState.query = val;
      appState.recentSearches = [val, ...appState.recentSearches.filter((s) => s.toLowerCase() !== val.toLowerCase())].slice(0, 4);
      const deskSearch = document.getElementById('desktopSearchInput');
      if (deskSearch) deskSearch.value = val;
      const phoneSearch = document.getElementById('phoneSearchInput');
      if (phoneSearch) phoneSearch.value = val;
      updateSearchResultContainers();
    };

    window.openRegistrationTicket = function(regRef) {
      const reg = appState.registrations.find((r) => r.ref === regRef) || appState.registrations[0];
      if (!reg) return;
      appState.tab = 'events';
      appState.selectedEvent = null;
      appState.selectedRegistration = reg;
      renderAll();
    };

    window.openTicketsShortcut = function() {
      if (appState.registrations.length) {
        openRegistrationTicket(appState.registrations[0].ref);
      } else {
        switchTab('events');
      }
    };

    window.showHomeAlerts = function() {
      if (appState.registrations.length) {
        setToast(`Active pass: ${appState.registrations[0].eventName} (${appState.registrations[0].ref})`);
      } else if (appState.user) {
        setToast(`Signed in as ${appState.user.fullName}. All passes synced.`);
      } else {
        setToast('All events, stays and rides are up to date.');
      }
    };

    window.openFeedDestination = function(type) {
      if (type === 'stay') switchTab('stays');
      else if (type === 'transport') switchTab('rides');
      else if (type === 'tourism') switchTab('adventure');
      else switchTab('events');
    };

    window.setOs = function(nextOs) {
      appState.os = nextOs === 'android' ? 'android' : 'ios';
      renderPhone();
    };

    window.pingBackendHealth = async function() {
      try {
        const res = await api('/api/health/ping');
        appState.healthStatus = `Connected (${res.status || 'ok'})`;
      } catch {
        appState.healthStatus = 'Unable to reach /api/health/ping';
